{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/marketcheck.js": { "maxDuration": 60 },
    "api/score.js": { "maxDuration": 60 },
    "api/baseline.js": { "maxDuration": 60 },
    "api/pricecheck.js": { "maxDuration": 60 },
    "api/pricecomps.js": { "maxDuration": 60 },
    "api/cron-sync.js": { "maxDuration": 60 }
  },
  "crons": [{ "path": "/api/cron-sync", "schedule": "0 10 * * *" }],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
