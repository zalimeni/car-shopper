# Supabase connection (optional overrides).
# These are the public project URL and publishable/anon key — safe to expose
# in the client. Row Level Security protects the data. Copy to .env.local for
# local dev, or set them in the Vercel project settings to point at a different
# Supabase project. If unset, the defaults in src/supabaseClient.js are used.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# MarketCheck listing-aggregator key, used ONLY by the serverless proxy
# (api/marketcheck.js) for the dealer-inventory sync. Server-side secret —
# NOT prefixed with VITE_, so it is never bundled into the browser. Set it in
# the Vercel project settings (Environment Variables). Get a key at
# https://www.marketcheck.com/apis . Host override is optional.
MARKETCHECK_API_KEY=your_marketcheck_key_here
# MARKETCHECK_HOST=https://mc-api.marketcheck.com
# Search radius in miles. Free tier is capped at 100; raise on a paid plan.
# MARKETCHECK_RADIUS=100

# Access allowlist FALLBACK for the /api functions. Once db/allowlist.sql is
# applied, the public.allowed_emails table is the single source of truth (it
# also governs RLS), and this env var is ignored. Until then, this comma-
# separated list (default: owner's email) gates the sync proxy. Anyone can sign
# up via magic-link, but only allowlisted emails are served / can touch data.
# ALLOWED_EMAILS=mzalimeni@gmail.com,someone@example.com
