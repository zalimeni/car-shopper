# Supabase connection (optional overrides).
# These are the public project URL and publishable/anon key — safe to expose
# in the client. Row Level Security protects the data. Copy to .env.local for
# local dev, or set them in the Vercel project settings to point at a different
# Supabase project. The serverless functions read the same two variables. If
# unset, the defaults in src/supabaseClient.js / api/_supabaseAdmin.js are used.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# Supabase Secret key (sb_secret_...) — bypasses RLS to reach the server-only
# tables: the allowlist (allowed_emails), the encrypted key vault
# (user_api_keys) and the backups (app_state_history). From Supabase: Project
# Settings → API Keys → Secret keys. Server-side only. Without it, the Admin
# tab, key storage, backups and the scheduled sync are disabled.
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# Encryption key for the stored API keys (AES-256-GCM, api/_crypto.js). Use a
# long random value (>= 16 chars; e.g. `openssl rand -base64 32`). Rotating it
# invalidates all stored keys — users simply re-enter theirs.
KEY_ENCRYPTION_SECRET=generate-a-long-random-string-here

# Shared MarketCheck listing-aggregator key, used ONLY by the serverless
# functions and ONLY for accounts that have no MarketCheck keys of their own in
# Settings. Once a user has any key, this one is ignored for them entirely —
# never a fallback, even when theirs run out. Server-side secret — NOT prefixed
# with VITE_. Get a key at https://www.marketcheck.com/apis . Optional.
MARKETCHECK_API_KEY=your_marketcheck_key_here

# ── Scheduled background sync (optional) ───────────────────────────────────
# vercel.json schedules GET /api/cron-sync daily; the sync is inert until
# CRON_SECRET is set (>= 16 chars — Vercel sends it as the Bearer token on
# cron invocations, so nobody else can trigger it). It then runs for the
# accounts marked "Daily sync" in the Admin tab (allowed_emails.scheduled_sync).
# Server-side only.
# CRON_SECRET=generate-a-long-random-string-here

# Who may use the app, and who is an admin, lives in the database
# (public.allowed_emails, managed from the Admin tab) — not in env vars.
