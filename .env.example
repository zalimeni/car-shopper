# Supabase connection (optional overrides).
# These are the public project URL and publishable/anon key — safe to expose
# in the client. Row Level Security protects the data. Copy to .env.local for
# local dev, or set them in the Vercel project settings to point at a different
# Supabase project. If unset, the defaults in src/supabaseClient.js are used.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# MarketCheck listing-aggregator key, used ONLY by the serverless proxy
# (api/marketcheck.js) for the dealer-inventory sync. Server-side secret —
# NOT prefixed with VITE_, so it is never bundled into the browser. Set it in
# the Vercel project settings (Environment Variables). Get a key at
# https://www.marketcheck.com/apis . Host override is optional.
MARKETCHECK_API_KEY=your_marketcheck_key_here
# MARKETCHECK_HOST=https://mc-api.marketcheck.com
# Search radius in miles. Free tier is capped at 100; raise on a paid plan.
# MARKETCHECK_RADIUS=100
# Delay (ms) between sequential queries to stay under the burst rate limit.
# Lower it on a paid plan for faster syncs. 429s are retried with backoff.
# MARKETCHECK_THROTTLE_MS=500

# Access allowlist for the /api functions. A signed-in account is allowed if it
# is in THIS list OR in the public.allowed_emails DB table (supabase/migrations,
# which also governs RLS). This env var always applies — handy for granting
# access without a DB write, and it works before the migration is applied.
# Comma-separated; defaults to the owner's email. Anyone can sign up via
# magic-link, but only allowlisted emails are served / can touch data.
# ALLOWED_EMAILS=mzalimeni@gmail.com,someone@example.com

# Optional debug bypass for the /api endpoints. If set (use a long random value,
# >= 24 chars), a caller presenting it as the Bearer token is authorized WITHOUT
# a Supabase session — for headless/agent debugging of the sync (e.g.
# /api/marketcheck?raw=1) that sidesteps the email magic-link flow. Grants the
# API surface only (no DB/user-data access; RLS still applies to data). Server-
# only secret — never VITE_-prefixed. Rotate to revoke. Leave unset to disable.
# DEBUG_TOKEN=generate-a-long-random-string-here
